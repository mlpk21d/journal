DATABASE_URL=postgresql://journal_user:replace_me@127.0.0.1:5432/trade_journal
WEBULL_APP_KEY=
WEBULL_APP_SECRET=
# sandbox | production
WEBULL_ENV=sandbox
# Keep false when Webull API 2FA is disabled. Enable only after 2FA token activation.
WEBULL_USE_ACCESS_TOKEN=false
WEBULL_ACCESS_TOKEN=
# Required for all journal API routes and sync operations
JOURNAL_API_TOKEN=

# Financial Modeling Prep (server-side stock/ETF quotes and 5-minute historical candles)
FMP_API_KEY=
